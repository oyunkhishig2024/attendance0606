# Real deployment: point at a MongoDB Atlas (or any Mongo) instance.
MONGO_URL=mongodb://localhost:27017
# Local/dev without a MongoDB server at all -- uses mongomock-motor in-process.
# MONGO_URL=mongomock://localhost/employee_tracker

DB_NAME=employee_tracker
JWT_SECRET=change-me-to-a-random-32-byte-secret

# Only needed once, to create the first platform administrator (see app/seed.py).
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me

# Set to "true" only in a throwaway/dev database (spec §12.12: never in production).
SEED_DEMO_DATA=false
